<!-- ==========================
        JAVASCRIPT
=========================== -->

<script>
<script>

// ===============================
//      SOUND
// ===============================

const clickSound = new Audio("../suara/blub.mp3");
clickSound.volume = 0.8;

// ===============================
//      ELEMENT
// ===============================

const popup = document.getElementById("popup");
const popupText = document.getElementById("popup-text");

// ===============================
//      PLAY SOUND
// ===============================

function playClickSound(){

    clickSound.currentTime = 0;

    clickSound.play().catch(()=>{});

}

// ===============================
//      POPUP
// ===============================

function showPopup(text){

    popupText.innerHTML = text;

    popup.classList.add("show");

}

function closePopup(){

    popup.classList.remove("show");

}

// Tutup popup jika klik area luar
window.addEventListener("click",function(e){

    if(e.target===popup){

        closePopup();

    }

});

// Tutup popup dengan tombol ESC
document.addEventListener("keydown",function(e){

    if(e.key==="Escape"){

        closePopup();

    }

});

// ===============================
//      NAVIGASI
// ===============================

document.querySelectorAll("a").forEach(link=>{

    link.addEventListener("click",function(e){

        playClickSound();

        // Jika bukan tombol kelas,
        // biarkan langsung menuju halaman
        if(!this.classList.contains("button-kelas")){

            return;

        }

        const kelas=this.textContent.trim();

        // Hanya kelas 5 yang aktif
        if(kelas!=="5"){

            e.preventDefault();

            showPopup(

                "🚧 <b>Kelas "+kelas+"</b><br><br>" +

                "Materi pembelajaran masih dalam tahap pengembangan.<br><br>" +

                "Silakan kembali lagi nanti.<br><br>" +

                "Terima kasih 😊"

            );

            return;

        }

    });

});

// ===============================
//      EFEK HOVER
// ===============================

document.querySelectorAll(".button-kelas").forEach(btn=>{

    btn.addEventListener("mouseenter",()=>{

        btn.style.transition=".25s";

    });

});

// ===============================
//      LOADING
// ===============================

window.addEventListener("load",()=>{

    document.body.style.opacity="1";

});

</script>

