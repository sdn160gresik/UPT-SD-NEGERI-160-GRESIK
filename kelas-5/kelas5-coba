<!DOCTYPE html>
<html lang="id">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Pilih Kelas - UPT SD Negeri 160 Gresik</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{

    font-family:'Poppins',sans-serif;

    background:url('https://i.imgur.com/Gup5sKD.png') center center/cover no-repeat fixed;

    min-height:100vh;

    overflow-x:hidden;

    position:relative;
}

/* ===========================
   Overlay Background
=========================== */

.overlay{

    position:fixed;

    inset:0;

    background:
    linear-gradient(
        rgba(0,0,0,.18),
        rgba(0,0,0,.25)
    );

    z-index:-1;
}

/* ===========================
        NAVBAR
=========================== */

nav{

    display:flex;

    align-items:center;

    justify-content:space-between;

    flex-wrap:wrap;

    gap:20px;

    padding:15px 35px;

    background:rgba(255,255,255,.18);

    backdrop-filter:blur(15px);

    border-bottom:1px solid rgba(255,255,255,.35);

    box-shadow:0 10px 30px rgba(0,0,0,.18);

}

.nav-logo{

    display:flex;

    align-items:center;

    gap:18px;
}

.nav-logo img{

    height:60px;

    transition:.3s;
}

.nav-logo img:hover{

    transform:scale(1.08);
}

.nav-title{

    flex:1;

    text-align:center;

    color:white;
}

.nav-title h1{

    font-size:30px;

    font-weight:800;

    letter-spacing:1px;

    text-shadow:
    2px 2px 10px rgba(0,0,0,.4);

}

.nav-title p{

    margin-top:6px;

    font-size:15px;

    font-weight:400;

    opacity:.95;
}

/* ===========================
        MENU
=========================== */

.nav-menu{

    display:flex;

    gap:10px;

    flex-wrap:wrap;
}

.nav-menu a{

    text-decoration:none;

    color:white;

    background:rgba(255,255,255,.15);

    backdrop-filter:blur(10px);

    border:1px solid rgba(255,255,255,.45);

    padding:10px 20px;

    border-radius:50px;

    transition:.3s;

    font-size:15px;

    font-weight:600;

    box-shadow:0 5px 15px rgba(0,0,0,.1);
}

.nav-menu a:hover{

    background:white;

    color:#0288d1;

    transform:translateY(-3px);

    box-shadow:0 8px 20px rgba(0,0,0,.18);
}

/* ===========================
      CONTAINER
=========================== */

.container{

    width:100%;

    max-width:1200px;

    margin:auto;

    padding:70px 20px;

    text-align:center;
}

.subjudul{

    display:inline-block;

    padding:18px 35px;

    background:rgba(0,0,0,.35);

    backdrop-filter:blur(10px);

    color:white;

    border-radius:50px;

    font-size:30px;

    font-weight:700;

    box-shadow:0 12px 30px rgba(0,0,0,.25);

    margin-bottom:50px;
}

.judul-kelas{

    font-size:44px;

    color:white;

    font-weight:800;

    letter-spacing:2px;

    margin-bottom:35px;

    text-shadow:
    3px 3px 12px rgba(0,0,0,.45);
}

/* ===========================
      TOMBOL KELAS
=========================== */

.kelas-baris{

    display:flex;

    justify-content:center;

    flex-wrap:wrap;

    gap:28px;
}

.button-kelas{

    width:100px;

    height:100px;

    border-radius:50%;

    display:flex;

    align-items:center;

    justify-content:center;

    text-decoration:none;

    font-size:38px;

    font-weight:800;

    color:white;

    border:5px solid white;

    text-shadow:
    1px 2px 4px rgba(0,0,0,.4);

    box-shadow:
    0 12px 28px rgba(0,0,0,.25);

    transition:.35s;
}

.button-kelas:hover{

    transform:
    scale(1.12)
    rotate(-5deg);

    box-shadow:
    0 20px 35px rgba(0,0,0,.35);
}

/* ===========================
    WARNA TOMBOL
=========================== */

.kelas1{

    background:linear-gradient(135deg,#FFD54F,#F9A825);
}

.kelas2{

    background:linear-gradient(135deg,#8D6E63,#5D4037);
}

.kelas3{

    background:linear-gradient(135deg,#FF80AB,#EC407A);
}

.kelas4{

    background:linear-gradient(135deg,#FFB74D,#F57C00);
}

.kelas5{

    background:linear-gradient(135deg,#424242,#000000);
}

.kelas6{

    background:linear-gradient(135deg,#E53935,#8E0000);
}

/* ===========================
        POPUP
=========================== */

.popup{

    position:fixed;

    top:50%;

    left:50%;

    transform:
    translate(-50%,-50%)
    scale(.7);

    width:360px;

    max-width:90%;

    padding:35px;

    border-radius:22px;

    background:white;

    text-align:center;

    box-shadow:
    0 25px 45px rgba(0,0,0,.3);

    opacity:0;

    pointer-events:none;

    transition:.3s;

    z-index:999;
}

.popup.show{

    opacity:1;

    pointer-events:auto;

    transform:
    translate(-50%,-50%)
    scale(1);
}

.popup button{

    margin-top:22px;

    border:none;

    background:#0288d1;

    color:white;

    padding:12px 28px;

    border-radius:40px;

    font-size:16px;

    font-weight:600;

    cursor:pointer;

    transition:.3s;
}

.popup button:hover{

    background:#01579B;
}

/* ===========================
        FOOTER
=========================== */

.footer{

    margin-top:80px;

    padding:28px;

    text-align:center;

    color:white;

    background:rgba(0,0,0,.35);

    backdrop-filter:blur(12px);

    font-size:15px;

    line-height:1.8;
}

/* ===========================
      RESPONSIVE
=========================== */

@media(max-width:900px){

    nav{

        flex-direction:column;

        text-align:center;
    }

    .nav-title{

        order:3;
    }

}

@media(max-width:768px){

    .nav-title h1{

        font-size:22px;
    }

    .subjudul{

        font-size:22px;

        padding:15px 25px;
    }

    .judul-kelas{

        font-size:34px;
    }

    .button-kelas{

        width:80px;

        height:80px;

        font-size:30px;
    }

}

@media(max-width:480px){

    .nav-logo img{

        height:45px;
    }

    .button-kelas{

        width:70px;

        height:70px;

        font-size:24px;
    }

    .kelas-baris{

        gap:18px;
    }

}

</style>

</head>
<body>

