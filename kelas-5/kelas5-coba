        <img src="https://i.imgur.com/sxm7RR1.png" alt="Logo Gresik">

        <img src="https://i.imgur.com/tGA5UBc.png"
             alt="Logo Tut Wuri"
             style="height:68px;">

        <img src="https://i.imgur.com/oWB8vKW.png"
             alt="Logo Sekolah">

    </div>

    <div class="nav-title">

        <h1>UPT SD NEGERI 160 GRESIK</h1>

        <p>Portal Pembelajaran Digital</p>

    </div>

    <div class="nav-menu">

        <a href="../index.html">
            🏠 Beranda
        </a>

        <a href="pengumuman/pengumuman.html">
            📌 Pengumuman
        </a>

        <a href="#">
            📞 Kontak
        </a>

    </div>

</nav>

<!-- ==========================
        KONTEN
=========================== -->

<div class="container">

    <div class="subjudul">

        📚 Selamat Datang di Portal Pembelajaran

    </div>

    <h2 class="judul-kelas">

        PILIH KELAS

    </h2>

    <div class="kelas-baris">

        <a href="kelas1.html"
           class="button-kelas kelas1"
           title="Kelas 1">
            1
        </a>

        <a href="kelas2.html"
           class="button-kelas kelas2"
           title="Kelas 2">
            2
        </a>

        <a href="kelas3.html"
           class="button-kelas kelas3"
           title="Kelas 3">
            3
        </a>

        <a href="kelas4.html"
           class="button-kelas kelas4"
           title="Kelas 4">
