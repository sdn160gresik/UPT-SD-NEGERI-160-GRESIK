    </div>

</div>

<!-- ==========================
        POPUP
=========================== -->

<div id="popup" class="popup">

    <h2 style="margin-bottom:15px;">

        🚧 Informasi

    </h2>

    <div id="popup-text">

        Kelas ini sedang dipersiapkan.

    </div>

    <button onclick="closePopup()">

        OK

    </button>

</div>

