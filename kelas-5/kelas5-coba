        </a>

        <a href="Petualangan-Kelas-5.html"
           class="button-kelas kelas5"
           title="Kelas 5">
            5
        </a>

        <a href="kelas6.html"
           class="button-kelas kelas6"
           title="Kelas 6">
            6
